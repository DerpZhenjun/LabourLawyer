{
  "name": "labourlawyer-web",
  "private": true,
  "version": "1.2.0-preview.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "contracts:build": "node ../scripts/sync-client-release.mjs --check && node ../scripts/build-api-contracts.mjs && node ../scripts/build-regional-contracts.mjs && node ../scripts/build-client-contracts.mjs",
    "contracts:check": "node ../scripts/sync-client-release.mjs --check && node ../scripts/build-api-contracts.mjs --check && node ../scripts/build-regional-contracts.mjs --check && node ../scripts/build-client-contracts.mjs --check",
    "typecheck": "vue-tsc --noEmit",
    "prebuild": "npm run contracts:build",
    "clients:check": "node ../scripts/client-pipeline.mjs check --targets web,mini",
    "clients:build": "node ../scripts/client-pipeline.mjs build --targets web,mini"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@noble/hashes": "2.4.0",
    "axios": "^1.13.2",
    "bootstrap": "^5.3.8",
    "dompurify": "^3.3.1",
    "marked": "^17.0.1",
    "sass": "^1.97.1",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.3.13"
  }
}
