{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {"@/*": ["src/*"]}
  },
  "vueCompilerOptions": {"strictTemplates": true},
  "include": [
    "src/**/*.ts",
    "src/components/RegionalContractFields.vue",
    "src/components/JiangsuOwnFields.vue",
    "src/components/ZhejiangOwnFields.vue",
    "../packages/regional-contracts/src/**/*.ts"
  ]
}
