).addClass(cl);\\n                        }\\n                    })\\n                }\\n                $('input[type=\\\"radio\\\"]').on('click', function() {\\n                    check('input[type=\\\"radio\\\"]', 'radio_bg_check');\\n                })\\n                $('input[type=\\\"checkbox\\\"]').on('click', function() {\\n                    check('input[type=\\\"checkbox\\\"]', 'checkbox_bg_check');\\n                })\\n            },\\n            inputStyleNew: function() {\\n                function check(el, cl) {\\n                    $(el).closest(\\\".sx_list\\\").find(\\\"i\\\").each(function() {\\n                        $(this).removeClass(cl);\\n                        var checked = $(this).find(\\\"input\\\").prop('checked');\\n                        if (checked) {\\n                            $(this).addClass(cl);\\n                        }\\n                    })\\n                }\\n                $('input[type=\\\"radio\\\"]').on('click', function() {\\n                    check(this, 'radio_bg_check');\\n                })\\n                $('input[type=\\\"checkbox\\\"]').on('click', function() {\\n                    check(this, 'checkbox_bg_check');\\n                })\\n            }\\n        })\\n    })(jQuery);\\n\\n    $(function () {\\n        //情形tab切换\\n        $(\\\".qx_tab span\\\").click(function () {\\n            $(this).addClass(\\\"active\\\").siblings().removeClass(\\\"active\\\");\\n            var thisIndex = $(this).index();\\n            $(\\\".qx_cont\\\").eq(thisIndex).show().siblings(\\\".qx_cont\\\").hide();\\n        })\\n    })\\n\\n    //调用\\n    $(function() {\\n        //点击筛选弹窗\\n        $(\\\"#guide\\\").click(function () {\\n            $(\\\".zd .content\\\").empty();\\n            //默认获取顶级情形项\\n            var topParentIds = \\\"1\\\";\\n            getGuide(topParentIds, 0);\\n            $('.zd').css('display','block');\\n        })\\n        //关闭弹窗\\n        $(\\\".zd .smallbox em\\\").click(function () {\\n            $('.zd').css('display','none');\\n        })\\n\\n        //点击确认提交筛选情形项\\n        $(\\\".qrin\\\").click(function () {\\n            //筛选id集合\\n            var curIdsArr = [];\\n            // 提示语\\n            var showTips = \\\"已选择办事情形：\\\\\\\"\\\";\\n            $(\\\".input_style .sel\\\").closest(\\\".sx_list\\\").each(function (index_p, item_p) {\\n                var selFatherName = $(item_p).prev(\\\".sx_tit\\\").children(\\\"span\\\").eq(2).text().trim();\\n                showTips += selFatherName + \\\"：\\\";\\n                $(item_p).find(\\\"input.sel\\\").each(function (index_c, item_c) {\\n                    var selSonName = $(item_c).attr(\\\"data-name\\\");\\n                    var selGuideId = $(item_c).val();\\n                    curIdsArr.push(selGuideId);\\n                    if (index_c == 0) {\\n                        showTips += selSonName;\\n                    } else {\\n                        showTips += \\\"、\\\" + selSonName;\\n                    }\\n                });\\n                showTips += \\\"；\\\";\\n            });\\n            showTips += \\\"\\\\\\\"\\\";\\n            //根据选中情形去获取材料信息\\n            if (curIdsArr.length > 0) {\\n                $(\\\".sqcl_tit .fxl\\\").find(\\\"span\\\").text(showTips);\\n                var curIdsStr = curIdsArr.join(\\\",\\\");\\n                chooseGuideMat(curIdsStr);\\n                //把老版情形筛选条件取消\\n                $(\\\".section5_mid .right li.active\\\").removeClass(\\\"active\\\");\\n                $(\\\"#guide_reset\\\").show();\\n            }\\n            //关闭弹窗\\n            $('.zd').css('display','none');\\n        })\\n\\n        //绑定重置情形条件点击事件\\n        $(\\\"#guide_reset\\\").click(function () {\\n            $(\\\".sqcl_tit .fxl\\\").find(\\\"span\\\").text(\\\"提示：请先选择您的办事情形，我们将为您精确展示办事所需提供的申报材料。\\\");\\n            //展示全部材料\\n            var curIdsStr = \\\"\\\";\\n            chooseGuideMat(curIdsStr);\\n            //隐藏重