             var parentAnswerType = guideList[i].answerType;\\n                            if(parentAnswerType == \\\"0\\\") {\\n                                guideHtml += '<lable>\\\\n' +\\n                                    '               <i class=\\\\'input_style radio_bg\\\\'>\\\\n' +\\n                                    '                    <input type=\\\"radio\\\" data-flag=\\\"'+sonGuideList[j].sonFlag+'\\\" data-j=\\\"'+j+'\\\" data-name=\\\"'+sonGuideList[j].guideName+'\\\"' +\\n                                    ' data-parentid=\\\"'+sonGuideList[j].parentId+'\\\" name=\\\"p_'+guideList[i].id+'\\\" value=\\\"'+sonGuideList[j].id+'\\\">\\\\n' +\\n                                    '               </i>\\\\n'+\\n                                    '               <span>'+sonGuideList[j].guideName+'</span>\\\\n';\\n                                if (sonGuideList[j].remark != null && sonGuideList[j].remark != \\\"\\\") {\\n                                    guideHtml += '  <i class=\\\"guide_tips\\\" title=\\\"'+sonGuideList[j].remark+'\\\">\\\\n' +\\n                                        '               <img src=\\\"https://www.sczwfw.gov.cn/api-gateway/jpaas-jiq-sczw/static/intergratedQuery/style/demo/ywblbszn/images/tips.png\\\" alt=\\\"\\\">'+\\n                                        '           </i>';\\n                                }\\n                                guideHtml += '</lable>';\\n                            } else if (parentAnswerType == \\\"1\\\") {\\n                                guideHtml += '<lable>\\\\n' +\\n                                    '               <i class=\\\\'input_style checkbox_bg\\\\'>\\\\n' +\\n                                    '                    <input type=\\\"checkbox\\\" data-flag=\\\"'+sonGuideList[j].sonFlag+'\\\" data-j=\\\"'+j+'\\\" data-name=\\\"'+sonGuideList[j].guideName+'\\\"' +\\n                                    ' data-parentid=\\\"'+sonGuideList[j].parentId+'\\\" name=\\\"p_'+guideList[i].id+'\\\" value=\\\"'+sonGuideList[j].id+'\\\">\\\\n' +\\n                                    '               </i>\\\\n' +\\n                                    '               <span>'+sonGuideList[j].guideName+'</span>\\\\n';\\n                                if (sonGuideList[j].remark != null && sonGuideList[j].remark != \\\"\\\") {\\n                                    guideHtml += '  <i class=\\\"guide_tips\\\" title=\\\"'+sonGuideList[j].remark+'\\\">\\\\n' +\\n                                        '               <img src=\\\"https://www.sczwfw.gov.cn/api-gateway/jpaas-jiq-sczw/static/intergratedQuery/style/demo/ywblbszn/images/tips.png\\\" alt=\\\"\\\">'+\\n                                        '           </i>';\\n                                }\\n                                guideHtml += ' </lable>';\\n                            }\\n                            childHtml += '<div data-id=\\\"'+sonGuideList[j].id+'\\\"  class=\\\"childLess child'+sonGuideList[j].id+'\\\" ></div>'\\n                        }\\n                        guideHtml += '</div>';\\n                        guideHtml += childHtml;\\n                    }\\n                    guideHtml += '</div>';\\n                }\\n                var $guideHtml = $(guideHtml);\\n                $guideHtml.find(\\\"input\\\").bind(\\\"click\\\",function () {\\n                    var thisInputType = $(this).attr(\\\"type\\\");\\n                    var thisChecked = $(this).prop(\\\"checked\\\");\\n                    var sonFlag = $(this).attr(\\\"data-flag\\\");\\n                    var thisValue = $(this).val();\\n                    var thisJ = $(this).attr(\\\"data-j\\\");\\n                    var thisIndex = $(this).closest(\\\".sx_list\\\").prev(\\\".sx_tit\\\").find(\\\"span\\\").eq(0).text();\\n                    if (thisInputType == \\\"radio\\\"){\\n                        $(this).closest(\\\".sx_list\\\").siblings(\\\".childLess\\\").empty();\\n                    } else {\\n                        $(this).closest(\\\".sx_list\\\").siblings(\\\".child\\\"+thisValue).empty();\\n                    }\\n                    if (thisChecked) {\\n                        if (sonFlag == \\\"1\\\") {\\n                            changeInput(thisValue,thisIndex,thisJ);\\n                        }\\n                        $(this).addClass(\\\"sel\\\");\\n                        if (thisInputType == \\\"radio\\\"){\\n                            $(this).closest(\\\"lable\\\").siblings().find(\\\"input\\\").removeClass(\\\"sel\\\");\\n                        }\\n                    } else {\\n                        $(this).removeClass(\\\"sel\\\");\\n                    }\\n                })\\n                $(\\\".zd .content\\\").append($guideHtml);\\n                //初始化事件\\n                $.inputStyle();\\n            }\\n        });\\n    }\\n\\n    //点击input\\n    function changeInput(id,m,n){\\n        //发请求拿数据  然后插到  div  child 里\\n        var rowguid = $(\\\"#rowguid\\\").val();\\n        $.ajax({\\n            type: 'get',\\n            url: jiqUrl + \\\"/interface/item/guide\\\",\\n            dataType: 'json',\\n            async: false,\\n            data: {\\\"implListId\\\": rowguid, \\\"parentIds\\\": id},\\n            success: function (data) {\\n                var guideList = data.result;\\n                var guideHtml = '';\\n                var startIndex = 0;\\n                for (var i = 0; i < guideList.length; i++) {\\n                    startIndex += 1;\\n                    guideHtml += '<div class=\\\"sx_qx\\\">';\\n                    guideHtml += '<div class=\\\"sx_tit\\\">\\\\n' +\\n                        '                        <span>'+ m+'.'+(parseInt(n)+1) +'</span>\\\\n' +\\n                        '                        <span>、</span>\\\\n' +\\n                        '                        <span>' + guideList[i].guideName +'</span>\\\\n';\\n                    if (guideList[i].remark != 