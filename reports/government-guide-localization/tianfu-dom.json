                     guideHtml += '</div>';\\n                    }\\n                }\\n                var $guideHtml = $(guideHtml);\\n                $guideHtml.find(\\\"input\\\").bind(\\\"click\\\",function () {\\n                    var thisInputType = $(this).attr(\\\"type\\\");\\n                    var thisChecked = $(this).prop(\\\"checked\\\");\\n                    var sonFlag = $(this).attr(\\\"data-flag\\\");\\n                    var thisValue = $(this).val();\\n                    var thisJ = $(this).attr(\\\"data-j\\\");\\n                    var thisIndex = $(this).closest(\\\".sx_list\\\").prev(\\\".sx_tit\\\").find(\\\"span\\\").eq(0).text();\\n                    var thisParParId = $(this).closest(\\\".childLess\\\").attr(\\\"data-id\\\");\\n                    if (thisInputType == \\\"radio\\\"){\\n                        $(this).closest(\\\".sx_list\\\").siblings(\\\".childLess\\\").empty();\\n                    } else {\\n                        $(this).closest(\\\".sx_list\\\").siblings(\\\".child\\\"+thisValue).empty();\\n                    }\\n                    if (thisChecked) {\\n                        //有下级的加载下级情形\\n                        if (sonFlag == \\\"1\\\") {\\n                            changeInput( thisValue,thisIndex,thisJ);\\n                        }\\n                        //给这个input加上sel类，最后点确定时会循环有sel类的input\\n                        $(this).addClass(\\\"sel\\\");\\n                        //如果是radio的，将平级的其他radio清除sel类\\n                        if (thisInputType == \\\"radio\\\"){\\n                            $(this).closest(\\\"lable\\\").siblings().find(\\\"input\\\").removeClass(\\\"sel\\\");\\n                        }\\n                        //将这个input答案对应问题的父级问题清除sel类\\n                        $(\\\"input[value=\\\"+thisParParId+\\\"]\\\").removeClass(\\\"sel\\\");\\n                    } else {\\n                        //将这个input本身的sel清除\\n                        $(this).removeClass(\\\"sel\\\");\\n                        //判断当前点击的input的其他平级是否有任一一个选中了，若不是则将这个input答案对应问题的父级问题清除sel类\\n                        var isAllCancel = true;\\n                        $(this).closest(\\\"lable\\\").siblings().each(function (ind, brother) {\\n                            if ($(brother).find(\\\"input\\\").hasClass(\\\"sel\\\")) {\\n                                isAllCancel = false;\\n                            }\\n                        })\\n                        if (isAllCancel) {\\n                            $(\\\"input[value=\\\"+thisParParId+\\\"]\\\").addClass(\\\"sel\\\");\\n                        }\\n                    }\\n                })\\n                $(\\\".zd .content .child\\\"+id).append($guideHtml);\\n                $(\\\".zd .content .child\\\"+id).css({\\\"margin-bottom\\\": \\\"20px\\\",\\\"margin-left\\\":\\\"20px\\\"})\\n                //初始化事件\\n                $.inputStyle();\\n            },\\n        })\\n    }\\n\\n    // 根据情形获取材料\\n    function chooseGuideMat(ids){\\n        var taskType = $(\\\"#taskType\\\").val();\\n        var rowguid = $(\\\"#rowguid\\\").val();\\n        $.get(jiqUrl + \\\"/interface/item/guide_material\\\",\\n            {\\n                \\\"implListId\\\": rowguid,\\n                \\\"ids\\\" : ids,\\n                \\\"taskType\\\" : taskType\\n            },\\n            function(data){\\n                var list = data.result;\\n                fillMaterialHtml(list);\\n            });\\n    }\\n\\n    // 根据情形获取材料\\n    function chooseMat(id) {\\n        //获取input里的设定依据并转换为Json\\n        var allMaterials;\\n        try {\\n            allMaterials = $.parseJSON($(\\\"#materials\\\").val());\\n        } catch (e) {\\n            allMaterials == null;\\n        }\\n        var taskType = $(\\\"#taskType\\\").val();\\n        $.get(jiqUrl + \\\"/interface/item/material\\\",\\n            {\\n                \\\"ids\\\": id,\\n                \\\"taskType\\\": taskType\\n            },\\n            function (data) {\\n                var list = data.result;\\n                if (id == \\\"\\\") {\\n                    list = allMaterials;\\n                }\\n                fillMaterialHtml(list);\\n                //将新版情形筛选条件还原\\n                $(\\\".sqcl_tit .fxl\\\").find(\\\"span\\\").text(\\\"提示：请先选择您的办事情形，我们将为您精确展示办事所需提供的申报材料。\\\");\\n                //隐藏重置按钮\\n                $(\\\"#guide_reset\\\").hide();\\n            });\\n    }\\n\\n    //填充材料数据\\n    function fillMaterialHtml(list) {\\n        var content = \\\"\\\";\\n        var zhezhao = \\\"\\\";\\n        if (list.length > 0) {\\n            //获取input里的设定依据并转换为Json\\n            var lawRegulations;\\n            try {\\n                lawRegulations = $.parseJSON($(\\\"#lawRegulations\\\").val());\\n            } catch (e) {\\n                lawRegulations == null;\\n            }\\n            //开始拼接html\\n            content += '<table>';\\n            content += '<tr>';\\n            content += '<td colspan=\\\"2\\\">材料名称</td>';\\n            content += '<td>材料必要性</td>';\\n            content += '<td>材料类型</td>';\\n            content += '<td>材料形式</td>';\\n            content += '<td>纸质材料份数</td>';\\n            content += '<td>表格下载</td>';\\n            content += '<td>详情</td>';\\n            content += '</tr>';\\n            for (var i = 0; i < list.length; i++) {\\n                var num = i + 1;\\n\\n                var materialName = list[i].materialName;\\n                var zmaterialGuid = list[i].rowguid;\\n\\n                var isNeed = list[i].isNeed;\\n                var isLack = \\\"否\\\";\\n                if (isNeed != null) {\\n                    if (isNeed.indexOf(\\\"3\\\") != -1) {\\n                        isLack = \\\"是\\\";\\n                    }\\n                    isNeed = isNeed.replace(\\\",\\\", \\\"/\\\");\\n                    isNeed = isNeed.replace(\\\"1\\\", \\\"必要\\\");\\n                    isNeed = isNeed.replace(\\\"2\\\", \\\"非必要\\\");\\n                    isNeed = isNeed.replace(\\\"3\\\", \\\"容缺后补\\\");\\n                } else {\\n                    isNeed = \\\"无\\\";\\n                }\\n\\n                var materialType = list[i].materialType;\\n                if (materialType == null) {\\n                    materialType = \\\"无\\\";\\n                }\\n                if (materialType == \\\"1\\\") {\\n                    materialType = \\\"原件\\\";\\n                } else if (materialType == \\\"2\\\") {\\n                    materialType = \\\"复印件\\\"\\n                } else if (materialType == \\\"3\\\") {\\n                    materialType = \\\"原件和复印件\\\"\\n                } else if (materialType == \\\"L\\\") {\\n                    materialType = \\\"证照\\\"\\n                } else if (materialType == \\\"A\\\") {\\n                    materialType = \\\"批文\\\"\\n                } else if (materialType == \\\"Z\\\") {\\n                    materialType = \\\"证明\\\"\\n                } else if (materialType == \\\"Y\\\") {\\n                    materialType = \\\"一般材料\\\"\\n                } else if (materialType == \\\"B\\\") {\\n                    materialType = \\\"申请表单\\\"\\n                }\\n\\n                var materialFormat = list[i].materialFormat;\\n                if (materialFormat != null) {\\n                    materialFormat = materialFormat.replace(\\\",\\\", \\\"/\\\");\\n                    materialFormat = materialFormat.replace(\\\"1\\\", \\\"纸质\\\");\\n                    materialFormat = materialFormat.replace(\\\"2\\\", \\\"电子\\\");\\n                } else {\\n                    materialFormat = \\\"无\\\";\\n                }\\n\\n                var pageNum = 0;\\n                if (list[i].materialFormat.indexOf(\\\"1\\\") != -1) {\\n                    pageNum = list[i].pageNum;\\n                }\\n\\n                if (num > 5) {\\n                    content += '<tr class=\\\"trs\\\">';\\n                } else {\\n                    content += '<tr>';\\n                }\\n\\n                //电子材料格式\\n                var electMateStandard = list[i].electMateStandard;\\n                if (electMateStandard == null) {\\n                    electMateStandard = \\\"无\\\";\\n                } else {\\n                    electMateStandard = electMateStandard.replace(\\\"1\\\", \\\"pdf\\\");\\n                    electMateStandard = electMateStandard.replace(\\\"3\\\", \\\"jpg\\\");\\n                    electMateStandard = electMateStandard.replace(\\\"5\\\", \\\"不限\\\");\\n                }\\n\\n\\n                //来源渠道\\n                var sourceType = list[i].sourceType;\\n                if (sourceType == null) {\\n                    sourceType = \\\"无\\\";\\n                }\\n                if (sourceType == \\\"10\\\") {\\n                    sourceType = \\\"申请人自备\\\";\\n                } else if (sourceType == \\\"99\\\") {\\n                    sourceType = \\\"其他\\\"\\n                } else if (sourceType == \\\"20\\\") {\\n                    sourceType = \\\"政府部门核发\\\"\\n                }\\n\\n                // 来源渠道说明\\n                var sourceExplain = list[i].sourceExplain;\\n                if (sourceExplain == null) {\\n                    sourceExplain = '无';\\n                }\\n\\n                var pageFormat = list[i].pageFormat;\\n                if (pageFormat == null) {\\n                    pageFormat = \\\"无\\\";\\n                }\\n\\n                var signatureType = list[i].signatureType;\\n                if (signatureType == null) {\\n                    signatureType = \\\"无\\\";\\n                }\\n\\n                //填报须知\\n                var fillExplain = list[i].fillExplain;\\n                if (fillExplain == null) {\\n                    fillExplain = \\\"无\\\";\\n                }\\n\\n                var reduceTypeHtml = \\\"\\\";\\n                //是否减免\\n                var isReduce = list[i].isReduce;\\n                //减免模式\\n                var reduceType = list[i].reduceType;\\n                if (isReduce == null) {\\n                    isReduce = \\\"否\\\";\\n                    reduceType = \\\"无\\\";\\n                }\\n                if (isReduce == \\\"1\\\") {\\n                    isReduce = \\\"是\\\";\\n                    if (reduceType == \\\"1\\\") {\\n                        reduceType = \\\"免\\\";\\n                        reduceTypeHtml = \\\"<span class=\\\\\\\"isReduce isReduce-1\\\\\\\">免</span>\\\";\\n                    } else if (reduceType == \\\"0\\\") {\\n                        reduceType = \\\"减\\\"\\n                        reduceTypeHtml = \\\"<span class=\\\\\\\"isReduce isReduce-0\\\\\\\">减</span>\\\";\\n                    } else {\\n                        reduceType= \\\"无\\\";\\n                    }\\n                } else if (isReduce == \\\"0\\\") {\\n                    isReduce = \\\"否\\\"\\n                    reduceType = \\\"无\\\";\\n                }\\n\\n                var acceptStand = list[i].acceptStand;\\n                if (acceptStand == null) {\\n                    acceptStand = \\\"无\\\";\\n                }\\n\\n                var byLaw = list[i].byLaw;\\n                if (byLaw == null) {\\n                    byLaw = \\\"无\\\";\\n                }\\n\\n                var remark = list[i].remark;\\n                if (remark == null) {\\n                    remark = \\\"无\\\";\\n                }\\n\\n                if (lawRegulations != null && lawRegulations.length > 0) {\\n                    var lawNum = 0;\\n                    for (var k = 0; k < lawRegulations.length; k++) {\\n                        var lawOwnTag = lawRegulations[k].ownTag;\\n                        var ownId = lawRegulations[k].ownId;\\n                        var lawLawName = lawRegulations[k].lawName;\\n                        var lawLawType = lawRegulations[k].lawType;\\n                        if (lawOwnTag == \\\"4\\\" && ownId == zmaterialGuid) {\\n                            if (byLaw == \\\"无\\\") {\\n                                byLaw = \\\"\\\";\\n                            }\\n                            if (lawLawType == \\\"1\\\") {\\n                                lawLawType = \\\"法律\\\";\\n                            } else if (lawLawType == \\\"2\\\") {\\n                                lawLawType = \\\"行政法规\\\";\\n                            } else if (lawLawType == \\\"4\\\") {\\n                                lawLawType = \\\"地方法规\\\";\\n                            } else if (lawLawType == \\\"5\\\") {\\n                                lawLawType = \\\"部门规章\\\";\\n                            } else if (lawLawType == \\\"7\\\") {\\n                                lawLawType = \\\"其他\\\";\\n                            } else if (lawLawType == \\\"8\\\") {\\n                                lawLawType = \\\"政府规章\\\";\\n                            } else if (lawLawType == \\\"9\\\") {\\n                                lawLawType = \\\"规范性文件\\\";\\n                            }\\n                            var lawthLrContentList = lawRegulations[k].thLrContentList;\\n                            for (var j = 0; j < lawthLrContentList.length; j++) {\\n                                lawNum = lawNum + 1;\\n                                var lawclause = lawthLrContentList[j].clause;\\n                                var lawclauseContent = lawthLrContentList[j].clauseContent;\\n                                byLaw = byLaw + lawNum + \\\".\\\" + lawLawName + \\\"【\\\" + lawLawType + \\\"】\\\" + lawclause + \\\"：\\\" + lawclauseContent + \\\"\\\\r\\\\n\\\";\\n                            }\\n                            if (byLaw.length == 0) {\\n                                byLaw = \\\"无\\\";\\n                            }\\n                        }\\n                    }\\n                }\\n\\n                var exampleFilesList = list[i].exampleFiles;\\n                var emptyFilesList = list[i].emptyFiles;\\n\\n                content += '<td>' + num + '</td>';\\n                content += '<td><span style=\\\"margin-right: 5px\\\">' + materialName + '</span>'+reduceTypeHtml+'</td>';\\n                content += '<td>' + isNeed + '</td>';\\n                content += '<td>' + materialType + '</td>';\\n                content += '<td>' + materialFormat + '</td>';\\n                content += '<td>' + pageNum + '</td>';\\n                content += '<td>';\\n                if (exampleFilesList == null && emptyFilesList == null) {\\n                    content += '无';\\n                }\\n                if (emptyFilesList != null) {\\n                    content += '<a class=\\\"biao1\\\" >空白表格</a>';\\n                } else {\\n                    content += '<a class=\\\"biao1\\\" style=\\\"display:none\\\"></a>';\\n                }\\n                if (exampleFilesList != null) {\\n                    content += '<a class=\\\"biao2\\\" >示例样表</a>';\\n                } else {\\n                    content += '<a class=\\\"biao2\\\" style=\\\"display:none\\\"></a>';\\n                }\\n                content += '</td>';\\n                content += '<td>';\\n                content += '<a class=\\\"biao3\\\">查看更多</a>';\\n                content += '</td>';\\n                content += '</tr>';\\n\\n                var annexList = list[i].annexFiles;\\n                // 弹出的遮罩\\n                zhezhao += '<div class=\\\"zhezhao4\\\" style=\\\"display: none\\\">'\\n                    + '<div class=\\\"bigbox\\\"></div>'\\n                    + '<div class=\\\"smallbox\\\">'\\n                    + '<div class=\\\"top\\\">'\\n                    + '<span>详细信息</span>'\\n                    + '<em></em>'\\n                    + '</div>'\\n                    + '<div class=\\\"bottom\\\">'\\n                    + '<table>'\\n                    + '<tr>'\\n                    + '<td>名称</td>'\\n                    + '<td>操作</td>'\\n                    + '</tr>';\\n                if (emptyFilesList != null) {\\n                    for (var j = 0; j < emptyFilesList.length; j++) {\\n                        zhezhao += '<tr>'\\n                            + '<td>' + emptyFilesList[j].annexname + '</td>'\\n                            + '<td><a download=\\\"\\\" onclick=\\\"downloadAnnexFile(\\\\''+emptyFilesList[j].iid+'\\\\')\\\">下载</a></td>'\\n                            + '</tr>';\\n                    }\\n                }\\n                zhezhao += '</table>'\\n                    + '</div></div></div>';\\n\\n                zhezhao += '<div class=\\\"zhezhao2\\\" style=\\\"display: none\\\">'\\n                    + '<div class=\\\"bigbox\\\"></div>'\\n                    + '<div class=\\\"smallbox\\\">'\\n                    + '<div class=\\\"top\\\">'\\n                    + '<span>详细信息</span>'\\n                    + '<em></em>'\\n                    + '</div>'\\n                    + '<div class=\\\"bottom\\\">'\\n                    + '<table>'\\n                    + '<tr>'\\n                    + '<td>名称</td>'\\n                    + '<td>操作</td>'\\n                if (exampleFilesList != null) {\\n                    for (var j = 0; j < exampleFilesList.length; j++) {\\n                        zhezhao += '<tr>'\\n                            + '<td>' + exampleFilesList[j].annexname + '</td>'\\n                            + '<td><a download=\\\"\\\" onclick=\\\"downloadAnnexFile(\\\\''+exampleFilesList[j].iid+'\\\\');\\\">下载</a></td>'\\n                            + '</tr>';\\n                    }\\n                }\\n                zhezhao += '</table>'\\n                    + '</div></div></div>';\\n\\n                zhezhao += '<div class=\\\"zhezhao3\\\" style=\\\"display: none\\\">'\\n                    + '<div class=\\\"bigbox\\\"></div>'\\n                    + '<div class=\\\"smallbox\\\">'\\n                    + '<div class=\\\"top\\\">'\\n                    + '<span>办理材料详情</span>'\\n                    + '<em></em>'\\n                    + '</div>'\\n                    + '<div class=\\\"bottom\\\">'\\n                    + '<table><tr>'\\n                    + '<td>材料名称</td>'\\n                    + '<td colspan=\\\"3\\\">' + materialName + '</td>'\\n                    + '</tr>'\\n                    + '<tr>'\\n                    + '<td>材料形式</td>'\\n                    + '<td>' + materialFormat + '</td>'\\n                    + '<td>材料必要性</td>'\\n                    + '<td>' + isNeed + '</td>'\\n                    + '</tr>'\\n                    + '<tr>'\\n                    + '<td>材料类型</td>'\\n                    + '<td>' + materialType + '</td>'\\n                    + '<td>电子材料格式</td>'\\n                    + '<td>' + electMateStandard + '</td>'\\n                    + '</tr><tr>'\\n                    + '<td>来源渠道</td>'\\n                    + '<td>' + sourceType + '</td>'\\n                    + '<td>来源渠道说明</td>'\\n                    + '<td>' + sourceExplain + '</td>'\\n                    + '</tr><tr>'\\n                    + '<td>纸质材料份数</td>'\\n                    + '<td>' + pageNum + '</td>'\\n                    + '<td>纸质材料规格</td>'\\n                    + '<td>' + pageFormat + '</td>'\\n                    + '</tr><tr>'\\n                    + '<td>盖章或盖手印方式</td>'\\n                    + '<td>' + signatureType + '</td>'\\n                    + '<td>是否容缺</td>'\\n                    + '<td>' + isLack + '</td>'\\n                    + '</tr><tr>'\\n                    + '<td>是否减免</td>'\\n                    + '<td>' + isReduce + '</td>'\\n                    + '<td>减免模式</td>'\\n                    + '<td>' + reduceType + '</td>'\\n                    + '</tr><tr>'\\n                    + '</tr><tr>'\\n                    + '<td>填报须知</td>'\\n                    + '<td colspan=\\\"3\\\">' + fillExplain + '</td>'\\n                    + '</tr><tr>'\\n                    + '<td>受理标准</td>'\\n                    + '<td colspan=\\\"3\\\">' + acceptStand + '</td>'\\n                    + '</tr><tr>'\\n                    + '<td>要求提供材料的依据</td>'\\n                    + '<td colspan=\\\"3\\\">' + byLaw + '</td></tr>'\\n                    + '<tr>'\\n                    + '<td>备注</td>'\\n                    + '<td colspan=\\\"3\\\">' + remark + '</td>'\\n                    + '</tr></table></div></div></div>';\\n            }\\n            content += '</table>';\\n        } else {\\n            content += '<p style=\\\" line-height: 60px; background: #F5F6F8;margin-top: 20px;text-indent: 20px;\\\">该情形暂无材料信息</p>';\\n        }\\n        $(\\\"#material\\\").html(content);\\n        $(\\\"#zhezhao\\\").html(zhezhao);\\n        //判断材料份数，超过6份就显示更多按钮\\n        $(\\\".close2\\\").hide();\\n        var trs = $('#material>table tr').length;\\n        if (trs > 6) {\\n            $('.open2').show()\\n        } else {\\n            $('.open2').hide()\\n        }\\n        //按钮事件绑定\\n        $('.section5 .biao2').click(function () {\\n            var j = $(this).index('.biao2')\\n            $('.zhezhao2').eq(j).show()\\n        });\\n        $('.section5 .biao1').click(function () {\\n            var j = $(this).index('.biao1')\\n            $('.zhezhao4').eq(j).show()\\n        })\\n        $('.section5 .biao3').click(function () {\\n            var j = $(this).index('.biao3')\\n            $('.zhezhao3').eq(j).show();\\n        })\\n        $('.zhezhao2 em').click(function () {\\n            $('.zhezhao2').hide()\\n        })\\n        $('.zhezhao3 em').click(function () {\\n            $('.zhezhao3').hide()\\n        })\\n        $('.zhezhao4 em').click(function () {\\n            $('.zhezhao4').hide()\\n        })\\n    }\\n</script>\\n\\n<script>\\n    /*常规信息开关1*/\\n    $(\\\".open1\\\").click(function () {\\n        $(\\\".section4\\\").css('display', 'block');\\n        $(\\\".section3\\\").css('display', 'block');\\n        $(\\\".section2\\\").css('display', 'block');\\n        $(\\\".close1\\\").css('display', 'block');\\n        $(this).css('display', 'none');\\n    })\\n    $(\\\".close1\\\").click(function () {\\n        $(\\\".section4\\\").css('display', 'none');\\n        $(\\\".section3\\\").css('display', 'none');\\n        $(\\\".section2\\\").css('display', 'none');\\n        $(\\\".open1\\\").css('display', 'block');\\n        $(this).css('display', 'none')\\n    })\\n    /*申请材料开关2*/\\n    $(\\\".open2\\\").click(function () {\\n        $(\\\".trs\\\").css('display', 'table-row');\\n        $(\\\".close2\\\").css('display', 'block');\\n        $(this).css('display', 'none')\\n    })\\n    $(\\\".close2\\\").click(function () {\\n        $(\\\".trs\\\").css('display', 'none');\\n        $(\\\".open2\\\").css('display', 'block');\\n        $(this).css('display', 'none')\\n    })\\n    $(window).scrollbar({\\n        are: $('.scrollbar'),\\n        con: $('.content'),\\n        bar: $('.bar')\\n    });\\n    $('.section5_mid .right ul li').click(function () {\\n        $('.opne2').show();\\n        $('.close2').hide();\\n        $('.trs').hide()\\n    })\\n\\n    /* 滚动事件方法 */\\n    var scrollEventFun = function () {\\n        var windowScrollTop = $(window).scrollTop();\\n        var x1 = $(\\\".bigbox1\\\").height() + 460;\\n        var x2 = x1 + $(\\\".bigbox2\\\").outerHeight()\\n        var x3 = x2 + $(\\\".section6\\\").outerHeight()\\n        var x4 = x3 + $(\\\".section7\\\").outerHeight()\\n        var x5 = x4 + $(\\\".section8\\\").outerHeight()\\n        var x6 = x5 + $(\\\".section9\\\").outerHeight()\\n        var x7 = x6 + $(\\\".section10\\\").outerHeight()\\n        var x8 = x7 + $(\\\".section11\\\").outerHeight()\\n        if (windowScrollTop < 400) {\\n            $(\\\".bannerbg2\\\").css('display', 'none')\\n            $('.colum').removeClass('fix')\\n        } else {\\n            $(\\\".bannerbg2\\\").css('display', 'block')\\n            $('.colum').addClass('fix')\\n            handleLowResolutionRatio(x8);\\n        }\\n        if (windowScrollTop >= 400 && windowScrollTop < x1 - 10) {\\n            $(\\\".li1\\\").siblings().removeClass(\\\"active\\\");\\n            $('.li1').addClass(\\\"active\\\");\\n        }\\n        else if (windowScrollTop >= x1 - 10 && windowScrollTop < x2 - 10) {\\n            $(\\\".li2\\\").siblings().removeClass(\\\"active\\\");\\n            $('.li2').addClass(\\\"active\\\")\\n        }\\n        else if (windowScrollTop >= x2 - 10 && windowScrollTop < x3 - 10) {\\n            $(\\\".li3\\\").siblings().removeClass(\\\"active\\\");\\n            $('.li3').addClass(\\\"active\\\")\\n        }\\n        else if (windowScrollTop >= x3 - 10 && windowScrollTop < x4 - 10) {\\n            $(\\\".li4\\\").siblings().removeClass(\\\"active\\\");\\n            $('.li4').addClass(\\\"active\\\")\\n        }\\n        else if (windowScrollTop >= x4 - 10 && windowScrollTop < x5 - 10) {\\n            $(\\\".li5\\\").siblings().removeClass(\\\"active\\\");\\n            $('.li5').addClass(\\\"active\\\")\\n        }\\n        else if (windowScrollTop >= x5 - 10 && windowScrollTop < x6 - 10) {\\n            $(\\\".li6\\\").siblings().removeClass(\\\"active\\\");\\n            $('.li6').addClass(\\\"active\\\")\\n        }\\n        else if (windowScrollTop >= x6 - 10 && windowScrollTop < x7 - 10) {\\n            $(\\\".li7\\\").siblings().removeClass(\\\"active\\\");\\n            $('.li7').addClass(\\\"active\\\")\\n        }\\n        else if (windowScrollTop >= x7 - 10 && windowScrollTop < x8 - 10) {\\n            $(\\\".li8\\\").siblings().removeClass(\\\"active\\\");\\n            $('.li8').addClass(\\\"active\\\")\\n        }\\n        else if (windowScrollTop >= x8 - 10) {\\n            $(\\\".li9\\\").siblings().removeClass(\\\"active\\\");\\n            $('.li9').addClass(\\\"active\\\")\\n        }\\n    }\\n    $(window).bind('scroll', scrollEventFun);\\n\\n    //处理在低分辨率下左侧导航栏显示越界\\n    function handleLowResolutionRatio(x8) {\\n        $('.colum').removeClass('absolute');\\n        var scrollDiffer = (x8 - 10) - $(window).scrollTop();\\n        if (scrollDiffer <= $('.colum').height() + 80 - parseInt($('.colum').css(\\\"top\\\"))) {\\n            $('.colum').removeClass('fix').addClass('absolute');\\n        } else {\\n            $('.colum').removeClass('absolute').addClass('fix');\\n        }\\n    }\\n\\n    /* colum高亮 */\\n    $(\\\".colum li\\\").click(function () {\\n        $(this).siblings().removeClass(\\\"active\\\")\\n        $(this).addClass(\\\"active\\\")\\n        // 先解绑滚动监听事件，再添加，防止事件冲突\\n        $(window).unbind('scroll');\\n        // 每个导航滚动一定高度\\n        var x1 = $(\\\".bigbox1\\\").height() + 460;\\n        var x2 = x1 + $(\\\".bigbox2\\\").outerHeight()\\n        var x3 = x2 + $(\\\".section6\\\").outerHeight()\\n        var x4 = x3 + $(\\\".section7\\\").outerHeight()\\n        var x5 = x4 + $(\\\".section8\\\").outerHeight()\\n        var x6 = x5 + $(\\\".section9\\\").outerHeight()\\n        var x7 = x6 + $(\\\".section10\\\").outerHeight()\\n        var x8 = x7 + $(\\\".section11\\\").outerHeight()\\n        var columChange = true;\\n        if ($(this).is($(\\\".li1\\\"))) {\\n            $(window).scrollTop(400)\\n        } else if ($(this).is($(\\\".li2\\\"))) {\\n            $(window).scrollTop(x1)\\n        } else if ($(this).is($(\\\".li3\\\"))) {\\n            $(window).scrollTop(x2)\\n        } else if ($(this).is($(\\\".li4\\\"))) {\\n            $(window).scrollTop(x3)\\n        } else if ($(this).is($(\\\".li5\\\"))) {\\n            $(window).scrollTop(x4)\\n        } else if ($(this).is($(\\\".li6\\\"))) {\\n            $(window).scrollTop(x5)\\n        } else if ($(this).is($(\\\".li7\\\"))) {\\n            $(window).scrollTop(x6)\\n        } else if ($(this).is($(\\\".li8\\\"))) {\\n            $(window).scrollTop(x7)\\n            if ($('.colum').hasClass(\\\"absolute\\\")) {\\n                columChange = false;\\n            }\\n        }\\n        if (columChange) {\\n            handleLowResolutionRatio(x8);\\n        }\\n        window.setTimeout(function () {\\n            $(window).bind('scroll', scrollEventFun);\\n            // 活动标题栏显示/隐藏\\n            var windowScrollTop = $(window).scrollTop();\\n            if (windowScrollTop < 400) {\\n                $(\\\".bannerbg2\\\").css('display', 'none')\\n                $('.colum').removeClass('fix')\\n            } else {\\n                $(\\\".bannerbg2\\\").css('display', 'block')\\n                $('.colum').addClass('fix')\\n            }\\n        },50)\\n    })\\n\\n    // 情形遮罩显示\\n    $(\\\".section5_mid .right span#condition_more\\\").click(function () {\\n        $(\\\".alone .zhezhao\\\").css('display', 'block')\\n        $(\\\".alone .smallbox\\\").css('display', 'block')\\n    })\\n    // 情形重置\\n    $(\\\".section5_mid .right span#condition_reset\\\").click(function () {\\n        // 展示全部材料\\n        chooseMat('');\\n        $(\\\".section5_mid .right li.active\\\").removeClass('active');\\n    })\\n\\n    $(\\\".zhezhao\\\").click(function () {\\n        $(\\\".alone .zhezhao\\\").css('display', 'none')\\n        $(\\\".alone .smallbox\\\").css('display', 'none')\\n    })\\n    $(\\\".submit\\\").click(function () {\\n        $(\\\".zhezhao\\\").css('display', 'none')\\n        $(\\\".smallbox\\\").css('display', 'none')\\n    })\\n    $(\\\".smallbox .box1 em\\\").click(function () {\\n        $(\\\".zhezhao\\\").css('display', 'none')\\n        $(this).closest(\\\".smallbox\\\").css('display', 'none')\\n    })\\n    /*选择查询*/\\n    $(\\\".section5_mid .right li\\\").click(function () {\\n        $(this).siblings().removeClass('active')\\n        $(this).addClass('active')\\n    })\\n    $('.smallbox .box2 ul>li').click(function () {\\n        if ($(this).hasClass('active')) {\\n            $(this).removeClass('active')\\n            $(this).next().hide()\\n        } else {\\n            $(this).addClass('active')\\n            $(this).siblings('li').removeClass('active')\\n            $(this).next().show()\\n            $(this).next().siblings('ol').hide()\\n        }\\n    })\\n    $('.smallbox .box2 ol li').click(function () {\\n        $('.smallbox .box2 ol li').removeClass('hover')\\n        $(this).addClass('hover')\\n        $('.only').removeClass('hover')\\n    })\\n\\n    $('.only').click(function () {\\n        if ($(this).hasClass('hover')) {\\n            $(this).removeClass('hover')\\n        } else {\\n            $(this).addClass('hover');\\n            $(this).siblings('.only').removeClass('hover')\\n            $('.smallbox .box2 ol li').removeClass('hover')\\n        }\\n    })\\n    // 更点情形点击筛选\\n    $(\\\".smallbox button\\\").click(function () {\\n        $(\\\".alone .zhezhao\\\").css('display', 'none');\\n        $(\\\".alone .smallbox\\\").css('display', 'none');\\n        //获取选中情形id\\n        var sitId = $('.smallbox .hover').attr(\\\"id\\\");\\n        if (sitId != undefined && sitId != \\\"\\\") {\\n            var sitTitle = $('.smallbox .hover').text();\\n            //选中情形\\n            $(\\\".section5_mid .qx_cont ul>li\\\").removeClass(\\\"active\\\");\\n            $(\\\".section5_mid .qx_cont ul>li[title=\\\"+sitTitle+\\\"]\\\").addClass(\\\"active\\\");\\n            chooseMat(sitId);\\n        }\\n    })\\n\\n    /*收费标准切换*/\\n    $(\\\".money p\\\").click(function () {\\n        $(this).siblings().removeClass('active');\\n        $(this).addClass('active');\\n        var index = $(this).index();\\n        $('.money_con1 p').eq(index).show().siblings().hide();\\n        $('.money_con2 p').eq(index).show().siblings().hide();\\n        $('.money_con2 table').eq(index).show().siblings().hide();\\n        $('.money_con3 p').eq(index).show().siblings().hide();\\n        $('.money_con4 p').eq(index).show().siblings().hide();\\n        $('.money_con5 p').eq(index).show().siblings().hide();\\n        $('.money_con6 p').eq(index).show().siblings().hide();\\n        $('.money_con7 p').eq(index).show().siblings().hide();\\n    })\\n    // 申请资料\\n    $(\\\".close2\\\").hide();\\n    var trs = $('#material>table tr').length;\\n    if (trs > 6) {\\n        $('.open2').show()\\n    } else {\\n        $('.open2').hide()\\n    }\\n    $('.section5 .biao1').click(function () {\\n        var j = $(this).index('.biao1')\\n        $('.zhezhao4').eq(j).show()\\n    })\\n    $('.section5 .biao2').click(function () {\\n        var j = $(this).index('.biao2')\\n        $('.zhezhao2').eq(j).show()\\n    });\\n    $('.section5 .biao3').click(function () {\\n        var j = $(this).index('.biao3')\\n        $('.zhezhao3').eq(j).show();\\n    })\\n    $('.zhezhao2 em').click(function () {\\n        $('.zhezhao2').hide()\\n    })\\n    $('.zhezhao3 em').click(function () {\\n        $('.zhezhao3').hide()\\n    })\\n    $('.zhezhao4 em').click(function () {\\n        $('.zhezhao4').hide()\\n    })\\n\\n    /*设定依据*/\\n    $('.section9 table td a:not(.lawUrl)').click(function () {\\n        var j = $(this).index('.section9 table td a:not(.lawUrl)')\\n        $('.section9 div.bigtc9').eq(j).show()\\n        $('.section9 div.smltc9').eq(j).show()\\n    })\\n    $('.section9 div.smltc9 em').click(function () {\\n        $('.section9 div.bigtc9').hide()\\n        $('.section9 div.smltc9').hide()\\n    })\\n\\n    /*收费依据*/\\n    $('.section8 table td a').click(function () {\\n        var j = $(this).index('.section8 table td a')\\n        $('.section8 div.bigtc9').eq(j).show()\\n        $('.section8 div.smltc9').eq(j).show()\\n    })\\n    $('.section8 div.smltc9 em').click(function () {\\n        $('.section8 div.bigtc9').hide()\\n        $('.section8 div.smltc9').hide()\\n    })\\n\\n    /*审核弹出*/\\n    $('.shenhebtn').click(function () {\\n        var j = $(this).index(\\\".shenhebtn\\\");\\n        $('.shenhe').eq(j).show();\\n    })\\n    $('.shenhe em').click(function () {\\n        $('.shenhe').hide()\\n    })\\n\\n    window.onload = function () {\\n        setTimeout(function (){\\n            // 默认选中栏目\\n            var activeColumn = '';\\n            if (activeColumn != \\\"\\\") {\\n                $(\\\".li\\\" + activeColumn).trigger(\\\"click\\\");\\n            }\\n        },50)\\n    }\\n</script>\\n\\n<script>\\n    function download2() {\\n        window.location = jiqUrl + \\\"/interface/bszn/export?areaCode=510110000000&itemCode=51201400800001-510110000000-000-11510110072405779A-1-00&taskType=20&taskHandleItem=null&deptCode=510110013\\\";\\n    }\\n\\n    // 下载附件\\n    function downloadAnnexFile(id) {\\n        $.get(jiqUrl + \\\"/interface/item/annex/encryptUrl\\\", {\\n                \\\"id\\\": id,\\n            },\\n            function(result){\\n                if (result.code == \\\"0\\\") {\\n                    window.location.href = result.data;\\n                }\\n            }\\n        );\\n    }\\n\\n    // 凉山州定制：跳转至民意直通车\\n    function toLiangShanMyztc(url, deptName, taskName) {\\n        $.ajax({\\n            type : 'get',\\n            url : juspaceUrl + \\\"/interface/check-login\\\",\\n            contentType : \\\"application/json; charset=utf-8\\\",\\n            async : false,\\n            dataType : 'json',\\n            crossDomain : true,\\n            success : function(data) {\\n                var isOk = data.success;\\n                if (isOk) {\\n                    // 只有线上才用sessionStorage传递参数\\n                    if (window.location.hostname == \\\"www.sczwfw.gov.cn\\\") {\\n                        window.sessionStorage.setItem(\\\"a\\\", deptName);\\n                        window.sessionStorage.setItem(\\\"b\\\", taskName);\\n                        url += \\\"?areaCode=513400000000&f=1\\\";\\n                    } else {\\n                        url += \\\"?areaCode=513400000000&f=2\\\"\\n                            + \\\"&a=\\\" + encodeURIComponent(deptName)\\n                            + \\\"&b=\\\" + encodeURIComponent(taskName);\\n                    }\\n                    window.open(url);\\n                } else {\\n                    /*弹出框打开*/\\n                    tckdk(data.message, data.code, url);\\n                }\\n            }\\n        });\\n    }\\n\\n    //教育厅6类事项的弹窗\\n    $(\\\".apply_close\\\").click(function(){\\n        $('.apply').hide();\\n        $(\\\"#512B0052900012-510000000000-000-11510000008282866T-1-00\\\").hide();\\n        $(\\\"#512B0052900015-510000000000-000-11510000008282866T-1-00\\\").hide();\\n        $(\\\"#512B0052900013-510000000000-000-11510000008282866T-1-00\\\").hide();\\n        $(\\\"#512B0052900017-510000000000-000-11510000008282866T-1-00\\\").hide();\\n        $(\\\"#512B0052900014-510000000000-000-11510000008282866T-1-00\\\").hide();\\n        $(\\\"#512B0052900018-510000000000-000-11510000008282866T-1-00\\\").hide();\\n    })\\n</script>\\n\\n<!-- 足迹埋点 -->\\n<meta http-equiv=\\\"pragma\\\" content=\\\"no-cache\\\">\\n<meta http-equiv=\\\"Cache-Control\\\" content=\\\"no-store, must-revalidate\\\">\\n<script type=\\\"text/javascript\\\">\\n    var jhome_uuid = \\\"\\\";\\n    function Base64() {\\n        var _keyStr = \\\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=\\\";\\n        this.encode = function (input) {\\n            var output = \\\"\\\";\\n            var chr1, chr2, chr3, enc1, enc2, enc3, enc4;\\n            var i = 0;\\n            input = input.replace(/\\\\r\\\\n/g, \\\"\\\\n\\\");\\n            var utftext = \\\"\\\";\\n            for (var n = 0; n < input.length; n++) {\\n                var c = input.charCodeAt(n);\\n                if (c < 128) {\\n                    utftext += String.fromCharCode(c);\\n                } else if ((c > 127) && (c < 2048)) {\\n                    utftext += String.fromCharCode((c >> 6) | 192);\\n                    utftext += String.fromCharCode((c & 63) | 128);\\n                } else {\\n                    utftext += String.fromCharCode((c >> 12) | 224);\\n                    utftext += String.fromCharCode(((c >> 6) & 63) | 128);\\n                    utftext += String.fromCharCode((c & 63) | 128);\\n                }\\n            }\\n            input = utftext;\\n            while (i < input.length) {\\n                chr1 = input.charCodeAt(i++);\\n                chr2 = input.charCodeAt(i++);\\n                chr3 = input.charCodeAt(i++);\\n                enc1 = chr1 >> 2;\\n                enc2 = ((chr1 & 3) << 4) | (chr2 >> 4);\\n                enc3 = ((chr2 & 15) << 2) | (chr3 >> 6);\\n                enc4 = chr3 & 63;\\n                if (isNaN(chr2)) {\\n                    enc3 = enc4 = 64;\\n                } else if (isNaN(chr3)) {\\n                    enc4 = 64;\\n                }\\n                output = output + _keyStr.charAt(enc1) + _keyStr.charAt(enc2) + _keyStr.charAt(enc3) + _keyStr.charAt(enc4);\\n            }\\n            return output;\\n        }\\n    }\\n\\n    (function () {\\n        var base = new Base64();\\n        var jhome = document.createElement(\\\"script\\\");\\n        jhome.type = \\\"text/javascript\\\";\\n        jhome.async = true;\\n        var addr = base.encode(window.location.href);\\n        var juspaceAddr = 'https://www.sczwfw.gov.cn/juspace';\\n        jhome.src = juspaceAddr + \\\"/interface/record/add?title=\\\" + document.title + \\\"&addr=\\\" + addr;\\n        var s = document.getElementsByTagName(\\\"script\\\")[0];\\n        s.parentNode.insertBefore(jhome, s);\\n    })();\\n</script>\\n<div id=\\\"jquery_jplayer\\\" style=\\\"width: 0px; height: 0px;\\\"><img id=\\\"jp_poster_0\\\" style=\\\"width: 0px; height: 0px; display: none;\\\"><audio id=\\\"jp_audio_0\\\" preload=\\\"metadata\\\"></audio></div><link type=\\\"text/css\\\" rel=\\\"stylesheet\\\" href=\\\"https://www.sczwfw.gov.cn/module/jslib/accessiblereading/css/barrierfree.css\\\"></body><!-- 自定义鼠标右键功能 --></html>\",\"text\":\" \\n四川天府新区\\n国家政务服务平台\\n四川省人民政府\\n首页\\n个人服务\\n法人服务\\n直通部门\\n直通乡镇\\n一件事服务\\n川渝通办\\n工程建设项目审批\\n劳动人事争议仲裁申请\\n\\n中共四川天府新区工作委员会社会工作部\\n\\n1 次\\n\\n