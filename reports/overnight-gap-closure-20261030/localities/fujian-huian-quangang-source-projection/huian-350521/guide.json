      {
        "unid": "0A525F38A47B743BEE0719C91BFC20E7",
        "lawImplementdate": "2008年5月1日",
        "lawLocalAreacode": null,
        "lawLevel": "01",
        "dirUnid": "3DE9ADCB21C7FA29302146DF4DDE9A65",
        "lawImplementdept": "全国人大常委会",
        "lawLocalAreaname": null,
        "lawSymbol": "主席令第八十号",
        "lawOrdernum": "1",
        "lawContent": "第二十一条  劳动争议仲裁委员会负责管辖本区域内发生的劳动争议。",
        "lawName": "中华人民共和国劳动争议调解仲裁法",
        "createTime": "2021-11-30 16:26:40",
        "lawLevelName": "法律",
        "lawStatus": "1",
        "timestamp": "2021-11-30 16:27:35.378"
      },
      {
        "unid": "69405710CB7B2A2B2A47F7FC1FBD3419",
        "lawImplementdate": "2017年7月1日",
        "lawLocalAreacode": null,
        "lawLevel": "04",
        "dirUnid": "3DE9ADCB21C7FA29302146DF4DDE9A65",
        "lawImplementdept": "人力资源和社会保障部",
        "lawLocalAreaname": null,
        "lawSymbol": "人力资源和社会保障部令第33号",
        "lawOrdernum": "2",
        "lawContent": "第二条 本规则适用下列争议的仲裁：\n（一）企业、个体经济组织、民办非企业单位等组织与劳动者之间，以及机关、事业单位、社会团体与其建立劳动关系的劳动者之间，因确认劳动关系，订立、履行、变更、解除和终止劳动合同，工作时间、休息休假、社会保险、福利、培训以及劳动保护，劳动报酬、工伤医疗费、经济补偿或者赔偿金等发生的争议；\n（二）实施公务员法的机关与聘任制公务员之间、参照公务员法管理的机关（单位）与聘任工作人员之间因履行聘任合同发生的争议；\n（三）事业单位与其建立人事关系的工作人员之间因终止人事关系以及履行聘用合同发生的争议；\n（四）社会团体与其建立人事关系的工作人员之间因终止人事关系以及履行聘用合同发生的争议；\n（五）军队文职人员用人单位与聘用制文职人员之间因履行聘用合同发生的争议；\n（六）法律、法规规定由劳动人事争议仲裁委员会（以下简称仲裁委员会）处理的其他争议。",
        "lawName": "劳动人事争议办案规则",
        "createTime": "2021-11-30 16:29:29",
        "lawLevelName": "规章",
        "lawStatus": "1",
        "timestamp": "2021-11-30 16:29:29.096"
      }
    ],
