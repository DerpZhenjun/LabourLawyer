      "html": "<html lang=\"en\"><head>\n    \n    \n        \n            \n                \n                    \n                        \n                            <meta http-equiv=\"Expires\" content=\"0\">\n                            <meta http-equiv=\"Pragma\" content=\"no-cache\">\n                            \n                            \n                            <!-- <script src=\"/bog-search-web/resources/js/plugins/jquery-1.8.2.js\"></script> -->\n                            <!-- <script src=\"/bog-search-web/resources/js/plugins/jquery-1.8.2.js\"></script> -->\n                            <script src=\"https://hm.baidu.com/hm.js?c74c2ea8449de24d7d03c74f730afb7e\"></script><script src=\"/bog-search-web/resources/js/plugins/jquery.js\"></script>\n                            <!-- æ éç¢æµè§ start -->\n                            <script src=\"/bog-search-web/resources/js/plugins/EasyReader/jquery.md5.min.js\"></script>\n                            <script src=\"/bog-search-web/resources/js/plugins/EasyReader/jquery.jplayer.min.js\"></script>\n                            <script src=\"/bog-search-web/resources/js/plugins/EasyReader/EasyReader.min.js\"></script>\n                            <!-- æ éç¢æµè§ end -->\n                            <script type=\"text/javascript\">\n                                window.UEDITOR_HOME_URL = \"/bog-search-web/resources/js/plugins/ueditor/\";\n                                var CONTEXTPATH = \"/bog-search-web\";\n                                var uniqueNum = \"6701\";\n                                // æ¥å£éå\n                                var daoConfig = {\n                                    gerData: CONTEXTPATH + '',\n                                };\n                            </script>\n                            <script>\n                                var _hmt = _hmt || [];\n                                (function() {\n                                    var hm = document.c