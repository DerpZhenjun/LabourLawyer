cescroll\" src=\"/bog-search-web/resources/js/apps/../plugins/jquery.nicescroll.min.js?bust=1793190314746\"></script><script type=\"text/javascript\" charset=\"utf-8\" async=\"\" data-requirecontext=\"_\" data-requiremodule=\"fly\" src=\"/bog-search-web/resources/js/apps/../plugins/flyui-1.0.4/js/flyui.js?bust=1793190314746\"></script><script type=\"text/javascript\" charset=\"utf-8\" async=\"\" data-requirecontext=\"_\" data-requiremodule=\"common\" src=\"/bog-search-web/resources/js/apps/../common/common.js?bust=1793190314746\"></script><script type=\"text/javascript\" charset=\"utf-8\" async=\"\" data-requirecontext=\"_\" data-requiremodule=\"mask\" src=\"/bog-search-web/resources/js/apps/../common/mask.js?bust=1793190314746\"></script></head>\n\n<body id=\"selectArea\">\n    <div class=\"select-area-wrap clearfix\">\n        <div class=\"area\">\n            <div class=\"area-title\">\n                <h5 class=\"show-location\">\n                    <!-- <span class=\"choose-tips\" data-jb=\"1\" data-id=\"340000000000\">\n                        安徽省\n                    </span> -->\n                    <span class=\"show-area\" data-bind=\"source: areaData\" data-template=\"areaTmpl\"><span class=\"item\" data-id=\"340000000000\" data-jb=\"1\">\n            <i class=\"iconfont icon-right\"></i>\n            <span class=\"area-item-wrap\">\n                <span class=\"area ell\" title=\"安徽省\" data-value=\"340000000000\" data-jb=\"1\">安徽省</span>\n            </span>\n        </span><span class=\"item\" data-id=\"340100000000\" data-jb=\"2\">\n            <i class=\"iconfont icon-right\"></i>\n            <span class=\"area-item-wrap\">\n                <span class=\"area ell\" title=\"合肥市\" data-value=\"340100000000\" data-jb=\"2\">合肥市</span>\n            </span>\n        </span><span class=\"item\" data-id=\"340103000000\" data-jb=\"3\">\n            <i class=\"iconfont icon-right\"></i>\n            <span class=\"area-item-wrap\">\n                <span class=\"area ell\" title=\"庐阳区\" data-value=\"340103000000\" data-jb=\"3\">庐阳区</span>\n            </span>\n        </span></span>\n                </h5>\n            </div>\n            <!-- <label>当前区域：</label><span style=\"color: #3279dc;\">安徽省</span> -->\n            <div class=\"area-wrap\" data-bind=\"source: areaArray\" data-template=\"chooseTemp\">\n        <span class=\"ell area-item\" title=\"合肥市\">\n            \n                <a href=\"javascript:void(0)\" disabled=\"\" id=\"340100000000\" data-jb=\"2\" data-index=\"0\">合肥市</a>\n            \n        </span>\n    \n        <span class=\"ell area-item\" title=\"淮北市\">\n            \n                <a href=\"javascript:void(0)\" disabled=\"\" id=\"340600000000\" data-jb=\"2\" data-index=\"1\">淮北市</a>\n            \n        </span>\n    \n        <span class=\"ell area-item\" title=\"亳州市\">\n            \n                <a href=\"javascript:void(0)\" disabled=\"\" id=\"341600000000\" data-jb=\"2\" data-index=\"2\">亳州市</a>\n            \n        </span>\n    \n        <span class=\"ell area-item\" title=\"宿州市\">\n            \n                <a href=\"javascript:void(0)\" disabled=\"\" id=\"341300000000\" data-jb=\"2\" data-index=\"3\">宿州市</a>\n            \n        </span>\n    \n        <span class=\"ell area-item\" title=\"蚌埠市\">\n            \n                <a href=\"javascript:void(0)\" disabled=\"\" id=\"340300000000\" data-jb=\"2\" data-index=\"4\">蚌埠市</a>\n            \n        </span>\n    \n        <span class=\"ell area-item\" title=\"阜阳市\">\n            \n                <a href=\"javascript:void(0)\" disabled=\"\" id=\"341200000000\" data-jb=\"2\" data-index=\"5\">阜阳市</a>\n            \n        </span>\n    \n        <span class=\"ell area-item\" title=\"淮南市\">\n            \n                <a href=\"javascript:void(0)\" disabled=\"\" id=\"340400000000\" data-jb=\"2\" data-index=\"6\">淮南市</a>\n            \n        </span>\n    \n        <span class=\"ell area-item\" title=\"滁州市\">\n            \n                <a href=\"javascript:void(0)\" disabled=\"\" id=\"341100000000\" data-jb=\"2\" data-index=\"7\">滁州市</a>\n            \n        </span>\n    \n        <span class=\"ell area-item\" title=\"六安市\">\n            \n                <a href=\"javascript:void(0)\" disabled=\"\" id=\"341500000000\" data-jb=\"2\" data-index=\"8\">六安市</a>\n            \n        </span>\n    \n        <span class=\"ell area-item\" title=\"马鞍山市\">\n            \n                <a href=\"javascript:void(0)\" disabled=\"\" id=\"340500000000\" data-jb=\"2\" data-index=\"9\">马鞍山市</a>\n            \n        </span>\n    \n        <span class=\"ell area-item\" title=\"芜湖市\">\n            \n                <a href=\"javascript:void(0)\" disabled=\"\" id=\"340200000000\" data-jb=\"2\" data-index=\"10\">芜湖市</a>\n            \n        </span>\n    \n        <span class=\"ell area-item\" title=\"宣城市\">\n            \n                <a href=\"javascript:void(0)\" disabled=\"\" id=\"341800000000\" data-jb=\"2\" data-index=\"11\">宣城市</a>\n            \n        </span>\n    \n        <span class=\"ell area-item\" title=\"铜陵市\">\n            \n                <a href=\"javascript:void(0)\" disabled=\"\" id=\"340700000000\" data-jb=\"2\" data-index=\"12\">铜陵市</a>\n            \n        </span>\n    \n        <span class=\"ell area-item\" title=\"池州市\">\n            \n                <a href=\"javascript:void(0)\" disabled=\"\" id=\"341700000000\" data-jb=\"2\" data-index=\"13\">池州市</a>\n            \n        </span>\n    \n        <span class=\"ell area-item\" title=\"安庆市\">\n            \n                <a href=\"javascript:void(0)\" disabled=\"\" id=\"340800000000\" data-jb=\"2\" data-index=\"14\">安庆市</a>\n            \n        </span>\n    \n        <span class=\"ell area-item\" title=\"黄山市\">\n            \n                <a href=\"javascript:void(0)\" disabled=\"\" id=\"341000000000\" data-jb=\"2\" data-index=\"15\">黄山市</a>\n            \n        </span>\n    </div>\n        </div>\n        <div class=\"tip-area-wrap\" style=\"display: none;\">办事区域：<span class=\"area-name\" data-bind=\"text: areaName\">庐阳区</span><span class=\"warning visibility\">当前区域未开通此服务,请选择其他区域</span></div>\n        <p class=\"ul-tip\" style=\"display: none;\">\n            根据您的户籍所在地推荐以下服务，您也可以手动选择其他区域进行查看\n        </p>\n        <ul class=\"matter-ul\" data-bind=\"source: matterList\" data-template=\"matterTemp\" data-auto-bind=\"false\">\n        <li class=\"matter-li\">\n            <span class=\"matter-span\" data-linkurl=\"http://hf.ahzwfw.gov.cn/bog-bsdt/static/workProcess/components/applicationMaterial.html?ssqdCode=da27275dce0645ffb87c9d9423e84452\" data-bind=\"click: convenienceServiceBtn\" title=\"【庐阳区】劳动人事争议仲裁申请\">【庐阳区】劳动人事争议仲裁申请</span>\n        </li>\n    </ul>\n        <!-- 定制 分页 -->\n        <div class=\"custom_btn_group clearfix\" style=\"display: block;\">\n          <p class=\"btn fl custom_btn prev no_val\">上一页</p>\n          <p class=\"fl btn custom_btn next no_val\">下一页</p>\n        </div>\n        <!-- 原始分页 --已注释 -->\n        <!-- <div data-role=\"pagination\" data-page-number=\"3,5\" data-num-display-entries=\"5\" data-num-edge-entries=\"0\"\n                        data-show-total=\"false\" data-show-switch=\"false\" data-first-text = '' data-last-text='' data-page-mode-page='pageNum'  data-bind=\"source: matterList\"></div> -->\n        <!-- <div class=\"confirm-btn confirm-btn-disabled\" data-bind=\"click: onfirmClick\">确定</div> -->\n    </div>\n\n\n<script type=\"text/html\" id=\"matterTemp\">\n    {{each $data as item,i}}\n        <li class=\"matter-li\">\n            <span class=\"matter-span\" data-linkUrl=\"{{item.url}}\" data-bind=\"click: convenienceServiceBtn\" title=\"【{{item.ssqdZoneName}}】{{item.ssqdName}}\">【{{item.ssqdZoneName}}】{{item.ssqdName}}</span>\n        </li>\n    {{/each}}\n</script>\n<!-- 下级地区选择模板 -->\n<script type=\"text/html\" id=\"chooseTemp\">\n    {{each $data as item,i}}\n        <span class=\"ell area-item\" title=\"{{item.text}}\">\n            {{if item.isExist == '0'}}\n                <a href=\"javascript:void(0)\" disabled id=\"{{item.value}}\" data-jb=\"{{item.jb}}\" data-index=\"{{i}}\">{{item.text}}</a>\n            {{else if item.isExist == '1'}}\n                <a href=\"javascript:void(0)\" id=\"{{item.value}}\" data-bind=\"click: chooseArea\" data-jb=\"{{item.jb}}\" data-index=\"{{i}}\">{{item.text}}</a>\n            {{else}}\n            <a href=\"javascript:void(0)\" id=\"{{item.value}}\" disabled data-jb=\"{{item.jb}}\" data-index=\"{{i}}\">{{item.text}}</a>\n            {{/if}}\n        </span>\n    {{/each}}\n</script>\n<script type=\"text/html\" id=\"areaTmpl\">\n    {{each $data as item i}}\n        <span class=\"item\" data-id=\"{{item.value}}\" data-jb=\"{{item.jb}}\">\n            <i class=\"iconfont icon-right\"></i>\n            <span class=\"area-item-wrap\">\n                <span class=\"area ell\" title=\"{{item.text}}\" data-value=\"{{item.value}}\" data-jb=\"{{item.jb}}\">{{item.text}}</span>\n            </span>\n        </span>\n    {{/each}}\n</script>\n<script type=\"text/javascript\" src=\"/bog-search-web/resources/js/plugins/require.js\" data-main=\"/bog-search-web/resources/js/apps/instantSearchHandle/select-area-jsjb-new.js?_t=6701\"></script>\n\n\n</body></html>",
