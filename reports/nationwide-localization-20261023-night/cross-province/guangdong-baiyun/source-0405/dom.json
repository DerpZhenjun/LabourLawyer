{
  "captured_at": "2026-10-23T20:01:49.285Z",
  "html": "<html><head>\n  <meta charset=\"utf-8\">\n  <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0\">\n  <meta name=\"SiteName\" content=\"广州市白云区人民政府门户网站\">\n<meta name=\"SiteDomain\" content=\"www.by.gov.cn\">\n<meta name=\"SiteIDCode\" content=\"4401110001\">\n<meta name=\"keywords\" content=\"裁决公告\">\n<meta name=\"description\" content=\"此栏目发布裁决公告信息。\">\n\n<meta name=\"ColumnName\" content=\"裁决公告\">\n<meta name=\"ColumnDescription\" content=\"此栏目发布裁决公告信息。\">\n<meta name=\"ColumnKeywords\" content=\"裁决\">\n<meta name=\"ColumnType\" content=\"通知公告\">\n\n<meta name=\"ArticleTitle\" content=\"白云区劳动人事争议仲裁申请材料清单\"> \n<meta name=\"PubDate\" content=\"2025-09-17 14:25:32\"> \n<meta name=\"ContentSource\" content=\"区人力资源社会保障局\">\n<meta name=\"Url\" content=\"https://www.by.gov.cn/gzjg/qrlzyhshbzj/zcgg/cjgg/content/post_10451075.html\"> \n<meta name=\"Keywords\" content=\"广州市白云区人民政府门户网站,白云区人民政府,白云区,白云\">\n<meta name=\"description\" content=\"广州市白云区人民政府门户网站（网址：www.by.gov.cn）是广州市白云区人民政府主办的面向公众的信息网站，由广州市白云区政务服务数据管理局负责建设与管理，网站设置了包括开设“要闻动态、政务公开、办事服务、互动交流、营商环境、走进白云、工作机构”七大频道，让您全方位了解白云区经济与社会发展的方方面面。\"><script>window.NFCMS_SITE_ID=200006;window.NFCMS_PUB_TYPE=\"post\";window.NFCMS_POST_ID=\"10451075\";window.NFCMS_CAT_ID=\"67917\";</script><script src=\"//statistics.gd.gov.cn/scripts/s.js?t=1792051216\" async=\"\"></script>\n<title>白云区劳动人事争议仲裁申请材料清单-广州市白云区人民政府门户网站</title>\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"/libs/base.css\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"/libs/hover.css\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"/2025/css/common.css\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"/2025/css/header.css\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"/2025/css/footer.css\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"/2025/css/detail.css\">\n  <script type=\"text/javascript\"