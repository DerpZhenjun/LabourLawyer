安机关备案号：44030402002847</em></a></p>\n            <p>深圳市人力资源和社会保障局信访邮箱：szrlzybzxf@hrss.sz.gov.cn　深圳市社会保险基金管理局信访邮箱：csixf@hrss.sz.gov.cn </p>\n        </div>\n    </div>\n</div>\n<script type=\"text/javascript\" src=\"/hrss/tanchukuang_js20181022.js\"></script>\n<link href=\"/hrss/wailian_tanchukuang_css20180515.css\" rel=\"stylesheet\" type=\"text/css\">\n<!---适老化---> \n <script defer=\"\" async=\"\" type=\"text/javascript\" src=\"/szslh/dist/aria.js?appid=32d5c663a018ff0f9a114f344f1c26ac\" charset=\"utf-8\" id=\"ariascripts\"></script> \n<script>\n        $(function(){\n            let flag = false;\n            $(\".shen_i\").on(\"mouseenter\",function(){\n                if($(\".aiewm\").hasClass(\"active\")){\n                    return;\n                }else{\n                    $(\".aiewm\").addClass(\"active\");\n                    flag = true;\n                }\n\n            })\n            $(\".shen_i\").on(\"mouseleave\",function(){\n                if(!flag){\n                    return;\n                }else {                     \n                  var timer = setTimeout(function () {\n                        clearTimeout(timer);\n                        $(\".aiewm\").removeClass(\"active\");\n                        flag = false;\n                    }, 1500);  \n                }\n            })\n\n            let flag1 = false;\n            $(\".stpt\").on(\"mouseenter\",function(){\n                if($(\".xcxm\").hasClass(\"active\")){\n                    return;\n                }else{\n                    $(\".xcxm\").addClass(\"active\");\n                    flag1 = true;\n                }\n\n            })\n            $(\".stpt\").on(\"mouseleave\",function(){\n                if(!flag1){\n                    return;\n                }else {                     \n                        $(\".xcxm\").removeClass(\"active\");\n                        flag1 = false;\n                }\n            })\n\n            let flag2 = false;\n            $(\".aqb\").on(\"mouseenter\",function(){\n                if($(\".qrcode\").hasClass(\"active\")){\n                    return;\n                }else{\n                    $(\".qrcode\").addClass(\"active\");\n                    flag2 = true;\n                }\n\n            })\n            $(\".aqb\").on(\"mouseleave\",function(){\n                if(!flag2){\n                    return;\n                }else {                     \n                        $(\".qrcode\").removeClass(\"active\");\n                        flag2 = false;\n                }\n            })\n        })\n\n  \n</script>\n<script src=\"/images2021/swiper.min.js\"></script>\n<script>\nwindow.onload = function() {\n\t var swiper = new Swiper('.BannerCont', {\n\t\t autoplay:true,\n\t\t loop:true,\n      pagination: {\n        clickable: true,\n        el: '.swiper-pagination',\n      },\n    });\n}\n</script>\n<!--归档-->\n<script>\nfunction parseISO8601(dateStringInRange) {\n   \tvar isoExp = /^\\s*(\\d{4})-(\\d\\d)-(\\d\\d)\\s*$/,\n       \tdate = new Date(NaN), month,\n       \tparts = isoExp.exec(dateStringInRange);\n   \tif(parts) {\n     \tmonth = +parts[2];\n     \tdate.setFullYear(parts[1], month - 1, parts[3]);\n     \tif(month != date.getMonth() + 1) {\n       \t\tdate.setTime(NaN);\n     \t}\n   \t}\n   \treturn date;\n}\n$(function() {\n\tvar date =1775529993 *1000//获取发布时间\n\tvar now= new Date().getTime();//获取当前时间\n\n//工作动态 、通知公告 栏目 做归档判断30456\n\t//{--% if NFD_CAT.id != 30409 or NFD_CAT.id != 30405 or NFD_CAT.id != 30689 %--}\n\t\n\t\n// 特殊处理，全部归档\n\t\n});\n</script>\n<!--归档 end-->\n<script id=\"_trs_ta_js\" src=\"//ta.trs.cn/c/js/ta.js?mpid=914\" async=\"async\" defer=\"defer\"></script> \n<div id=\"NewsArticleID\" style=\"display:none;\">12717688</div>\n<div id=\"NewsArticleTitle\" style=\"display:none;\">深圳市劳动争议调援裁诉一站式服务平台的查询登录渠道是？平台的具体作用是？深圳哪些区的劳动争议调解仲裁可以在平台上申请？</div>\n<div id=\"NewsEditionNumber\" style=\"display:none;\">30456</div>\n<div id=\"NewsEditionName\" style=\"display:none;\">劳动关系</div>\n<div id=\"NewsSource\" style=\"display:none\">深圳市人力资源和社会保障局</div>\n<div id=\"NewsType\" style=\"display:none\">normal</div>\n\n<script>window.NFCMS_SITE_ID=755011;window.NFCMS_PUB_TYPE=\"post\";window.NFCMS_POST_ID=\"12717688\";window.NFCMS_CAT_ID=\"30456\";</script><script src=\"//statistics.gd.gov.cn/scripts/s.js?t=1775529965\" async=\"\"></script>\n    \n<script>\nvar curWwwPath=\"https://hrss.sz.gov.cn/zmhd/cjwt/cjwt/ldgx/index.html\";\nvar chnldesc=\"劳动关系-\"+curWwwPath+\"-30456\";\nvar keywords=\"\";\nvar flag=true;\n\n     /*设置Cookie*/\nfunction setCookie(c_name, value) {\n var exdate = new Date(); //获取当前时间　\n exdate.setDate(exdate.getDate() + 365);　 //过期时间　　　　\n document.cookie = c_name + \"=\" +escape(value) +\";expires=\"+exdate.toGMTString()+\";path=/\"; \n};\n/*获取Cookie*/\nfunction getCookie(c_name) {\n var cookies = document.cookie; //获取cookie值\n var cookieLen = cookies.length; //获取cookie长度\n if (cookieLen > 0) { //cookie不为空时\n  var c_start = cookies.indexOf(c_name + '='); //查找需要cookie值在cookie中序号\n  if (c_start > -1) { //cookie值存在时\n   c_start += c_name.length + 1; //获取cookie值开始序列号\n   var c_end = cookies.indexOf(';', c_start); //获取cookie值结束序列号\n   if (c_end == -1) { //当cookie是最后一个时\n    c_end = cookieLen; //设置cookie值结束序列号为cookie长度\n   };\n   var cookieStr = unescape(cookies.substring(c_start, c_end)); //获取解码cookie值\n   //var cookieObj = cookieStr.split(';'); //分割cookie值\n   //index = ((index == null) ? 0 : index); //判断index是否传值\n   //var goalObj = cookieObj[index]; //索引数组\n   //var goalStr = goalObj.split('=');\n   //var getcook = goalStr[1]; //获取需要取的cookie值\n   return cookieStr;\n  }\n } else {\n  console.log('页面没有cookie');\n  return \"\";\n }\n};\n     /*设置关键词*/\nfunction setKeywords(){\nkeywords=getCookie('keywords');\nif(keywords!=null&&keywords!=\"\"){\n var keyword= keywords.split(',');  \n for(var i=0;i<keyword.length;i++){\n   var chnldesc1=chnldesc.split('-');\n   var keyword1=keyword[i].split('-');\n   if(keyword1[0]==chnldesc1[0]){\n    flag=false;\n    break;   \n   }\n  }\n if(flag){//当前关键词未包含\n   if(keyword.length==5)keywords=keywords.substring(keywords.indexOf(\",\")+1);//已有5个关键词\n   keywords=keywords+\",\"+chnldesc;\n   setCookie('keywords',keywords);\n  }\n  \n }else{setCookie('keywords',chnldesc);}\n}\n  setKeywords();\n // console.log(getCookie('keywords')+\"__________\"); //打印查询cookie值\n</script>\n\n\n\t\t<img src=\"//statistics.gd.gov.cn/visit/post?site=755011&amp;post=12717688&amp;t=0.3796529100104338\"><script type=\"text/javascript\" id=\"ariaConfigId\" charset=\"utf-8\" src=\"https://hrss.sz.gov.cn/szslh/dist/config.js?domain=hrss.sz.gov.cn&amp;v=4.8.1\"></script></body></html>",
  "tables": [],
  "text": "首页\n信息公开\n政务服务\n政民互动\n专题专栏\n政府在线\n\n政声传递 | 数据开放 | 网站年度报表 | 无障碍阅读| 进入关怀版| 网站支持IPV6\n\n首页 > 深圳市人力资源和社会保障局 > 政民互动 > 常见问题解答 > 常见问题 > 劳动关系\n深圳市劳动争议调援裁诉一站式服务平台的查询登录渠道是？平台的具体作用是？深圳哪些区的劳动争议调解仲裁可以在平台上申请？\n来源： 深圳市人力资源和社会保障局 发布日期：2026-04-07 10:46:33\n\n　　答：电脑端登录：直接登录深圳市劳动争议调援裁诉一站式服务平台，网址：https://hrsspub.sz.gov.cn/szldzc/login；或进入“深圳市人力资源和社会保障局”官网“劳动关系”版块，点击→“劳动人事仲裁”→“深圳市劳动争议调援裁诉服务平台”进入平台。 \n\n　　移动端登录：关注并进入“深圳人社”公众号，在底部菜单点击“办事”—“劳动争议处理”进入小程序。平台汇集调解、仲裁、法律援助、诉讼等多种纠纷解决资源，覆盖劳动争议处理全过程。福田区、罗湖区、南山区、盐田区、宝安区、龙岗区、龙华区、坪山区、光明区、大鹏新区、深汕特别合作区的劳动争议仲裁可以在平台上申请。\n\n分享到：\n直属机构网站\n友情链接\n版权保护| 隐私声明| 法律声明| 网站地图| 联系我们\n\n主办单位：深圳市人力资源和社会保障局 备案序号：粤ICP备10052879号 网站标识码：4403000055\n\n咨询投诉热线：12333 12345公安机关备案号：44030402002847\n\n深圳市人力资源和社会保障局信访邮箱：szrlzybzxf@hrss.sz.gov.cn　深圳市社会保险基金管理局信访邮箱：csixf@hrss.sz.gov.cn",
