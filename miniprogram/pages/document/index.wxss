.document-page{padding-bottom:50rpx}.title{display:block;font-weight:700;font-size:32rpx;margin-bottom:20rpx}.scope{display:block;color:#966419;font-size:25rpx;line-height:1.7}.note{display:block;font-size:24rpx;color:#64748b;line-height:1.7;margin:16rpx 0}.field{margin:28rpx 0}.field>text{display:block;font-size:26rpx;color:#334155;margin-bottom:12rpx}.field input,.field textarea,.picker{box-sizing:border-box;width:100%;min-height:78rpx;border:1rpx solid #d9e3e7;background:#f8fafb;border-radius:12rpx;padding:18rpx;font-size:28rpx}.field textarea{min-height:150rpx}.field button{margin-top:10rpx}.actions{display:flex;justify-content:space-between;margin:20rpx 0}.error{color:#b42318;line-height:1.6}.generate{margin-top:24rpx}
